# Configuration Apache / Hostinger pour FOCUS
# A deposer a la racine web, au meme niveau que index.html.

# ---------------------------------------------------------------
# 1. Routage SPA : indispensable.
# Sans ca, toute URL autre que "/" renvoie une 404 du serveur, car
# le fichier /contact n'existe pas sur le disque. React Router gere
# les routes cote client, mais encore faut-il que le serveur serve
# index.html au lieu de chercher un fichier.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Le dossier interne des pages pre-rendues n'est jamais servi en direct,
  # sinon chaque page existerait sous deux URLs.
  RewriteCond %{THE_REQUEST} \s/+_p/
  RewriteRule ^ - [R=404,L]

  # Une seule URL par page : /contact/ redirige vers /contact.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Anciens articles orientes etudiants, retires le 04/10/2026 :
  # 410 indique a Google qu'ils sont supprimes volontairement.
  RewriteRule ^articles/(aftermovie-gala-etudiant-budget-delais|aftermovie-wei-budget-videaste|video-recrutement-association-etudiante|briefer-videaste-evenement-etudiant|musique-aftermovie-droit-auteur|aftermovie-tournoi-sportif-etudiant|video-dossier-sponsoring-association-etudiante|cahier-des-charges-video-association-etudiante|aftermovie-business-game-hackathon-etudiant)$ - [G,L]

  # Les fichiers qui existent vraiment sont servis tels quels.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Chaque page est pre-rendue au build : /contact -> /_p/contact.html.
  RewriteCond %{DOCUMENT_ROOT}/_p/$1.html -f
  RewriteRule ^(.+)$ /_p/$1.html [L]
</IfModule>

# Toute URL inconnue renvoie un vrai 404, plus une copie de l'accueil en 200.
ErrorDocument 404 /_p/404.html

# ---------------------------------------------------------------
# 2. Types MIME corrects.
# Le manifest etait servi en text/plain, ce qui pousse les
# navigateurs et Google a l'ignorer, donc a ignorer les icones
# 192 et 512 qu'il declare.
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType image/x-icon               .ico
  AddType image/webp                 .webp
  AddType image/svg+xml              .svg
  AddType application/javascript     .js
  AddType text/css                   .css
  AddType application/json           .json
</IfModule>

# ---------------------------------------------------------------
# 3. Compression.
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# 4. Cache.
# Les assets buildes portent un hash dans leur nom, ils peuvent etre
# caches un an sans risque. index.html et les fichiers SEO ne doivent
# jamais l'etre, sinon un redeploiement passe inapercu.
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType application/xml       "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
